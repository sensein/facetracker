Bootstrap: docker
# Using TensorFlow base image with CUDA 12.2 support
From: nvcr.io/nvidia/tensorflow:23.10-tf2-py3

%help
    Facetracker application container with PyTorch 2.1.2 and OpenMMLab libraries.
    Base image provides TensorFlow and CUDA 12.2 support.

%files
    /home/yibei/facetracker/requirements-all.txt /opt/requirements-all.txt

%post
    echo "Setting non-interactive frontend for apt..."
    export DEBIAN_FRONTEND=noninteractive
    
    echo "Updating package lists and installing system dependencies..."
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        && rm -rf /var/lib/apt/lists/*

    echo "Upgrading pip..."
    python3 -m pip install --upgrade pip

    echo "Installing application dependencies from requirements..."
    cd /opt
    if [ -f "requirements-all.txt" ]; then
        python3 -m pip install --no-cache-dir -r requirements-all.txt
    else
        echo "Error: requirements-all.txt not found!"
        exit 1
    fi

    echo "Installing PyTorch for CUDA 12.1 compatibility..."
    python3 -m pip install --no-cache-dir \
        torch==2.1.2 \
        torchvision==0.16.2 \
        torchaudio==2.1.2 \
        --index-url https://download.pytorch.org/whl/cu121

    echo "Installing DeepFace..."
    git clone https://github.com/serengil/deepface.git /opt/deepface
    cd /opt/deepface
    python3 -m pip install -e .

    echo "Installing OpenMMLab libraries..."
    # Clean install of MMCV
    python3 -m pip uninstall -y mmcv mmcv-full || true
    
    # Set up for MMCV compilation
    export MMCV_WITH_OPS=1
    export TORCH_CUDA_ARCH_LIST="7.0 7.5 8.0 8.6 9.0+PTX"  # Support multiple architectures
    
    # Install MMCV, MMDetection, and MMPose
    python3 -m pip install --no-cache-dir mmcv==2.1.0
    python3 -m pip install --no-cache-dir mmdet==3.3.0
    python3 -m pip install --no-cache-dir mmpose==1.3.2

    echo "Cleaning up..."
    python3 -m pip cache purge

%environment
    # Basic environment setup
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    # TensorFlow GPU memory growth
    export TF_FORCE_GPU_ALLOW_GROWTH=true
    export TF_CPP_MIN_LOG_LEVEL=1

%runscript
    echo "Facetracker container ready!"
    echo "Usage: apptainer exec --nv -B /path/to/project:/opt <image.sif> python3 /opt/scripts/your_script.py"
    exec python3 "$@"