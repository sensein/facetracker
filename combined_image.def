Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export TORCH_CUDA_ARCH_LIST="7.0 7.5 8.0 8.6 9.0+PTX"
    export TORCH_NVCC_FLAGS="-Xfatbin -compress-all"
    export FORCE_CUDA=1
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES=compute,utility
    export NVIDIA_REQUIRE_CUDA="cuda>=12.1"
    export PATH=/opt/conda/bin:$PATH
    # TensorFlow GPU memory growth configuration
    export TF_FORCE_GPU_ALLOW_GROWTH=true
    export TF_CPP_MIN_LOG_LEVEL=1

%post
    echo "Setting non-interactive frontend for apt..."
    export DEBIAN_FRONTEND=noninteractive
    
    echo "Updating package lists and installing system dependencies..."
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        wget \
        curl \
        ca-certificates \
        libopenmpi-dev \
        python3.10 \
        python3.10-dev \
        python3.10-distutils \
        python3-pip \
        ffmpeg \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgl1-mesa-glx \
        ninja-build \
        libglib2.0-0 \
        libxrandr2 \
        libxss1 \
        libxcursor1 \
        libxcomposite1 \
        libasound2 \
        libxi6 \
        libxtst6 \
        portaudio19-dev \
        && rm -rf /var/lib/apt/lists/*
    
    echo "Creating symbolic links for Python..."
    ln -sf /usr/bin/python3.10 /usr/bin/python
    ln -sf /usr/bin/python3.10 /usr/bin/python3
    
    echo "Upgrading pip and installing basic tools..."
    pip3 install --no-cache-dir --upgrade pip setuptools wheel
    
    echo "Installing basic Python packages..."
    pip3 install --no-cache-dir \
        numpy \
        scipy \
        matplotlib \
        pandas \
        scikit-learn \
        pillow \
        opencv-python \
        tqdm \
        pyyaml \
        requests \
        ipython \
        jupyter \
        ipykernel \
        cython
    
    echo "Installing PyTorch with CUDA support..."
    pip3 install --no-cache-dir torch==2.5.1 torchvision==0.20.1 --extra-index-url https://download.pytorch.org/whl/cu121
    
    echo "Installing TensorFlow with GPU support..."
    pip3 install --no-cache-dir tensorflow==2.15.0
    
    echo "Installing essential packages from requirements..."
    pip3 install --no-cache-dir \
        mediapipe==0.10.21 \
        ultralytics \
        huggingface_hub==0.31.2 \
        jax==0.4.26 \
        jaxlib==0.4.26 \
        filterpy==1.4.5 \
        scenedetect==0.6.4 \
        sounddevice==0.5.1 \
        opencv-contrib-python==4.11.0.86
    
    echo "Installing OpenMMLab libraries..."
    pip3 install --no-cache-dir openmim
    
    echo "Building MMCV from source for better CUDA compatibility..."
    export MMCV_WITH_OPS=1
    export FORCE_CUDA=1
    pip3 install --no-cache-dir --no-build-isolation mmcv==2.1.0
    
    echo "Installing MMEngine and MMDetection..."
    mim install mmengine
    mim install "mmdet>=3.0.0"
    
    echo "Building MMPose from source for maximum compatibility..."
    cd /tmp
    git clone https://github.com/open-mmlab/mmpose.git
    cd mmpose
    pip3 install --no-cache-dir -r requirements.txt
    pip3 install --no-cache-dir --no-build-isolation -e .
    
    echo "Cloning DeepFace repository and installing in editable mode..."
    git clone https://github.com/serengil/deepface.git /opt/deepface
    cd /opt/deepface
    python3 -m pip install -e .
    
    echo "Cloning and installing SAM2..."
    git clone https://github.com/facebookresearch/sam2.git /opt/sam2
    cd /opt/sam2
    pip3 install -e .

%runscript
    exec python "$@"
